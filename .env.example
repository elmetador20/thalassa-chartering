# ============================================================================
# INCWORX — environment variables
#
# Copy to .env (git-ignored) and fill in. Never commit real values.
# This file is committed: it must only ever contain <placeholders>.
# Anything prefixed NEXT_PUBLIC_ is inlined into browser JavaScript — only
# values that are safe to publish may use that prefix.
# ============================================================================

# --- Database (Supabase PostgreSQL) -----------------------------------------
# Supabase dashboard → Connect. Both use the pooler host and the
# "postgres.<project-ref>" user; only the port differs. Use the same password
# in both, URL-encoded: write @ as %40, : as %3A, / as %2F, # as %23, % as %25.

# Runtime: Transaction pooler, port 6543. Used by the app.
DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Migrations: Session pooler, port 5432. Used only by the Prisma CLI.
# No ?schema= needed — prisma.config.ts pins the CLI to the `incworx` schema.
# (Supabase's direct db.<project-ref>.supabase.co host is IPv6-only and won't
# resolve on many networks; prefer the session pooler.)
DIRECT_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase public client keys --------------------------------------------
# Optional — the app does not currently use Supabase's client SDK. Public by
# design (they reach the browser); the report tables are not reachable with
# them, because they live in a schema Supabase's API does not expose.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<publishable-or-anon-key>"

# --- Cloudflare R2 (report PDFs) --------------------------------------------
# Server-side only — never prefix these with NEXT_PUBLIC_. Until all four are
# real values the site runs normally but PDF upload, preview and download are
# switched off with a clear "storage not connected" message.
#
# Cloudflare dashboard → R2:
#   Account ID          32 hex characters (R2 overview page)
#   Access key / secret  R2 → Manage API tokens → "Object Read & Write",
#                        restricted to the reports bucket only
#   Bucket               private — do NOT enable public access or r2.dev
R2_ACCOUNT_ID="<32-hex-account-id>"
R2_ACCESS_KEY_ID="<32-hex-access-key-id>"
R2_SECRET_ACCESS_KEY="<64-hex-secret-access-key>"
R2_BUCKET_NAME="<bucket-name>"
# Optional. Leave unset: the endpoint is derived from the account ID. Set it
# only for a jurisdiction bucket, e.g. https://<account-id>.eu.r2.cloudflarestorage.com
# R2_ENDPOINT=""

# --- Initial Super Admin (one-time: npm run db:seed) ------------------------
# Optional. Leave these unset and the seed asks for them instead, with the
# password hidden as you type — it then never touches a file or your shell
# history. If you do set them, delete them again once the seed has run.
# SUPER_ADMIN_NAME=""
# SUPER_ADMIN_EMAIL=""
# SUPER_ADMIN_PASSWORD=""

# Admin sessions need no secret: they are random tokens stored (hashed) in the
# database, not signed cookies, so there is no SESSION_SECRET to manage.
